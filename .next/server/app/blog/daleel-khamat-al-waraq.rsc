بقسم الهيرو (Hero Section) المذهل الذي يستعرض كافة خدمات ومنتجات المطبعة بتصميم في قمة الأناقة والشياكة، مع تأثيرات فيديو سينمائية جذابة وملفتة للانتباه تجعل تجربة التصفح ممتعة بصرياً. هذا الكود محسّن لأقصى درجة (Highly Optimized) ليعكس هوية Print Express كشركة رائدة."}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"Print Express\",\"description\":\"منصة طباعة رقمية متطورة تتميز بتجربة مستخدم خرافية، قسم طباعة مبتكر، وتصميم أنيق وجذاب يعكس احترافية الشركة.\",\"offers\":{\"@type\":\"AggregateOffer\",\"priceCurrency\":\"EGP\",\"lowPrice\":\"50\",\"highPrice\":\"5000\"}}"}}],["$","div",null,{"className":"flex flex-col min-h-screen w-full max-w-[100vw] relative","children":["$","$L6",null,{"children":[["$","$7",null,{"fallback":null,"children":["$","$L8",null,{}]}],["$","$L9",null,{"color":"#F7931E","initialPosition":0.08,"crawlSpeed":200,"height":3,"crawl":true,"showSpinner":false,"easing":"ease","speed":200,"shadow":"0 0 10px #F7931E,0 0 5px #F7931E","zIndex":1600}],["$","$La",null,{}],["$","$Lb",null,{}],["$","main",null,{"className":"flex-grow w-full","children":["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$c","errorStyles":[],"errorScripts":[],"template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":["$","div",null,{"className":"min-h-screen bg-[#0a0a0a] text-white flex items-center justify-center px-4 py-20 relative overflow-hidden","dir":"rtl","children":[["$","div",null,{"className":"absolute top-1/4 -right-20 w-96 h-96 bg-yellow-500/10 rounded-full blur-3xl pointer-events-none"}],["$","div",null,{"className":"absolute bottom-1/4 -left-20 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"}],["$","div",null,{"className":"max-w-xl w-full text-center relative z-10","children":[["$","div",null,{"className":"inline-flex items-center gap-2 px-4 py-1.5 rounded